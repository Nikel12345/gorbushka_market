# Модуль настроек: config.settings.dev | config.settings.prod
DJANGO_SETTINGS_MODULE=config.settings.dev

DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Любая БД в формате URL, например:
#   sqlite:///db.sqlite3
#   postgres://user:password@localhost:5432/gorbushka
DATABASE_URL=sqlite:///db.sqlite3

CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
CSRF_TRUSTED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Лимит попыток входа/регистрации с одного IP
THROTTLE_RATE_AUTH=10/min

# Максимальный размер фото товара, МБ
PRODUCT_IMAGE_MAX_MB=5
# Сколько фото может быть у одного товара
PRODUCT_IMAGES_MAX=10

# Какую часть покупки можно оплатить бонусами (0.5 = 50%)
BONUS_MAX_SHARE=0.5

# «С этим товаром часто покупают»: True — пересчёт после каждой покупки,
# False — только по cron: python manage.py refresh_bought_together
BOUGHT_TOGETHER_ON_PURCHASE=True

# Цены товаров хранятся в долларах, покупателю показываются в рублях по курсу ЦБ на сегодня.
# Свой постоянный курс вместо ЦБ (пусто — курс ЦБ):
USD_RUB_RATE=
# До скольки рублей округлять цену: 1 — до рубля, 10 — до десяти рублей, 0.01 — до копейки
PRICE_RUB_STEP=1
